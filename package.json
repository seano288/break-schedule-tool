{
  "name": "break-schedule-tool",
  "version": "2.0.0",
  "description": "Automated break scheduling tool for UKG schedule exports",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ api/src/ api/tests/",
    "tracer:azurite": "azurite --silent --location .azurite --debug .azurite/debug.log",
    "tracer:api": "npm --prefix api start",
    "tracer:web": "cd web && swa start",
    "tracer:dev": "concurrently -n azurite,api,web -c blue,green,magenta \"npm run tracer:azurite\" \"npm run tracer:api\" \"npm run tracer:web\""
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.6",
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-inject": "^5.0.0",
    "azurite": "^3.34.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.0",
    "bootstrap": "^4.6.2",
    "jquery": "^3.7.0",
    "popper.js": "^1.16.1",
    "xlsx": "^0.18.5"
  }
}
